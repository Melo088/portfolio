---
import { site } from '../data/site';

const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];
---

<header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a
      href="/"
      class="text-condensed text-lg font-black tracking-tight text-white"
      aria-label="Home"
    >
      {site.githubHandle}
    </a>
    <ul class="flex items-center gap-6 text-xs font-bold uppercase tracking-widest md:gap-10">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="link-reveal text-white">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
