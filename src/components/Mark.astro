---
/**
 * The "m" mark: Archivo at 900 weight, 125% width, italic, with an extra
 * forward shear, printed in ink.
 *
 * The ink is baked, not filtered live: the bleed was rendered once into
 * two alpha masks, dry and soaked (hover), each painted with currentColor
 * so the mark still follows the nav from paper to carbon. No SVG filter in
 * the fixed nav and no per-frame hover tween. The clean outline lives on
 * in the favicon.
 */
interface Props {
  class?: string;
}

const { class: cls = '' } = Astro.props;
---

<span class:list={['ink-mark', cls]} aria-hidden="true"></span>

<style>
  .ink-mark {
    position: relative;
    display: inline-block;
    vertical-align: top;
    aspect-ratio: 390 / 192;
  }
  .ink-mark::before,
  .ink-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: currentColor;
    -webkit-mask: url('/images/mark-dry.webp') center / contain no-repeat;
    mask: url('/images/mark-dry.webp') center / contain no-repeat;
    transition: opacity 0.45s ease;
  }
  .ink-mark::after {
    -webkit-mask-image: url('/images/mark-wet.webp');
    mask-image: url('/images/mark-wet.webp');
    opacity: 0;
  }
  :global(a:hover) > .ink-mark::before {
    opacity: 0;
  }
  :global(a:hover) > .ink-mark::after {
    opacity: 1;
  }
</style>
