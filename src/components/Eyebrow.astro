---
/**
 * Section eyebrow: the section name on a strip of ink tape (see .eyebrow
 * in global.css).
 */
interface Props {
  text: string;
  as?: 'p' | 'h2' | 'span';
  class?: string;
}

const { text, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  <span class="eyebrow-t">{text}</span>
</Tag>
