---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<a
  href={`/projects/${project.slug}`}
  class="group border-line hover:border-paper/50 block border transition-colors duration-300"
  data-cursor
>
  <div class="overflow-hidden">
    <img
      src={project.image}
      alt={`${project.shortTitle} project image`}
      width="1600"
      height="900"
      loading="lazy"
      class="aspect-video w-full object-cover grayscale transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex items-start justify-between gap-4 p-6">
    <div>
      <p class="text-muted text-xs font-bold tracking-widest">{number} · {project.year}</p>
      <h3 class="text-condensed mt-2 text-xl font-black uppercase leading-tight md:text-2xl">
        {project.shortTitle}
      </h3>
      <p class="text-muted mt-3 max-w-prose text-sm leading-relaxed">{project.summary}</p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
        {
          project.stack.slice(0, 5).map((tech) => (
            <li class="border-line text-muted border px-2 py-1 text-[10px] font-bold uppercase tracking-wider">
              {tech}
            </li>
          ))
        }
        {
          project.stack.length > 5 && (
            <li class="text-muted px-1 py-1 text-[10px] font-bold tracking-wider">
              +{project.stack.length - 5}
            </li>
          )
        }
      </ul>
    </div>
    <span
      class="mt-1 inline-block text-2xl transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
      aria-hidden="true"
    >
      ↗
    </span>
  </div>
</a>
