---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const shown = project.stack.slice(0, 6);
const rest = project.stack.length - shown.length;
---

<li class="border-rule border-b">
  <a
    href={`/projects/${project.slug}`}
    class="project-row group grid grid-cols-12 items-start gap-x-4 gap-y-4 py-9 md:py-12"
    data-cursor
  >
    <span class="mono text-fg-3 col-span-2 pt-2 text-xs md:col-span-1">{number}</span>

    <div class="col-span-10 md:col-span-8">
      <h3 class="headline ink-md text-[2rem] transition-transform duration-500 ease-out group-hover:translate-x-2 md:text-5xl">
        {project.shortTitle}
      </h3>
      <p class="text-fg-2 mt-4 max-w-2xl text-[15px] leading-relaxed md:text-base">{project.summary}</p>
      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack">
        {shown.map((tech) => <li class="chip">{tech}</li>)}
        {rest > 0 && <li class="chip">+{rest}</li>}
      </ul>
    </div>

    <div class="mono text-fg-3 col-span-10 col-start-3 flex items-start justify-between gap-4 text-[11px] leading-relaxed md:col-span-3 md:col-start-auto md:flex-col md:items-end md:text-right">
      <div>
        <p>{project.context}</p>
        <p class="text-fg-2 mt-1">{project.date}</p>
      </div>
      <span
        class="text-fg inline-block text-3xl transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 md:mt-6"
        aria-hidden="true"
      >
        ↗
      </span>
    </div>
  </a>
</li>

<style>
  .project-row {
    position: relative;
  }
  /* A pale wash that rises under the row on hover, like ink lifting. */
  .project-row::before {
    content: '';
    position: absolute;
    inset: 0 -1.25rem;
    background: var(--chip);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    border-radius: 2px;
  }
  .project-row:hover::before {
    opacity: 1;
  }
</style>
