---
import InkWord from './InkWord.astro';
import { site } from '../data/site';
import MagneticLink from '../react/MagneticLink';

const year = new Date().getFullYear();
---

<footer id="contact" class="surface-carbon scroll-mt-0" data-surface="carbon">
  <div class="mx-auto max-w-6xl px-5 pb-8 pt-24 md:px-8 md:pt-36">
    <p class="label">(06) Contact</p>
    <InkWord text="hello." class="mt-6 text-[clamp(5rem,17vw,14rem)]" />
    <p class="text-fg-2 mt-10 max-w-xl text-lg leading-relaxed">
      A platform to build, a pipeline to untangle or a question about one of these projects: write to me.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <MagneticLink client:visible href={`mailto:${site.email}`} variant="solid">
        {site.email}
      </MagneticLink>
      <MagneticLink client:visible href={site.github} external>
        GitHub
      </MagneticLink>
      <MagneticLink client:visible href={site.linkedin} external>
        LinkedIn
      </MagneticLink>
      <MagneticLink client:visible href="/cv">CV</MagneticLink>
    </div>

    <div class="border-rule mt-24 flex flex-col gap-2 border-t pt-6 md:flex-row md:items-center md:justify-between">
      <p class="label">© {year} {site.name}</p>
      <p class="label">{site.location} · Ink rendered in WebGL</p>
    </div>
  </div>
</footer>
