---
import Base from '../../layouts/Base.astro';
import MagneticLink from '../../react/MagneticLink';
import BlurReveal from '../../react/BlurReveal';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const index = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const number = String(index + 1).padStart(2, '0');
---

<Base title={project.shortTitle} description={project.summary}>
  <article class="mx-auto max-w-6xl px-5 pb-24 pt-32 md:px-8 md:pt-40">
    <a href="/#work" class="label link-reveal">← All work</a>

    <header class="border-rule mt-12 border-b pb-12">
      <p class="label">({number}) {project.context} · {project.date}</p>
      <h1 class="headline ink-md mt-6 max-w-5xl text-[clamp(2.6rem,6.2vw,5.6rem)]">
        <BlurReveal client:load text={project.title} step={30} />
      </h1>
      <p class="text-fg-2 mt-8 max-w-3xl text-lg leading-relaxed md:text-xl">{project.summary}</p>
    </header>

    <div class="grid gap-x-16 md:grid-cols-12">
      <div class="md:col-span-8">
        <section class="border-rule border-b py-12">
          <h2 class="label">The project</h2>
          <div class="mt-6 space-y-5">
            {project.description.map((p) => <p class="text-fg-2 text-[17px] leading-relaxed">{p}</p>)}
          </div>
        </section>

        <section class="py-12">
          <h2 class="label">Highlights</h2>
          <ol class="mt-6">
            {
              project.highlights.map((h, i) => (
                <li class="border-rule flex gap-5 border-b py-4 leading-relaxed">
                  <span class="mono text-fg-3 pt-0.5 text-xs">{String(i + 1).padStart(2, '0')}</span>
                  <span>{h}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="md:col-span-4">
        <div class="md:sticky md:top-28">
          <dl class="border-rule border-b py-12">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <dt class="label">Date</dt>
                <dd class="display mt-2 text-2xl">{project.date}</dd>
              </div>
              <div>
                <dt class="label">No.</dt>
                <dd class="display mt-2 text-2xl">{number}</dd>
              </div>
            </div>
            <dt class="label mt-8">Stack</dt>
            <dd class="mt-4">
              <ul class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => <li class="chip">{tech}</li>)}
              </ul>
            </dd>
          </dl>
          {
            project.repo && (
              <div class="pt-8">
                <MagneticLink client:visible href={project.repo} variant="solid" external>
                  {project.repoLabel ?? 'View repository'} ↗
                </MagneticLink>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <nav class="border-rule mt-16 grid grid-cols-2 gap-6 border-t pt-8" aria-label="Other projects">
      <a href={`/projects/${prev.slug}`} class="group">
        <span class="label">← Previous</span>
        <span class="headline mt-2 block text-xl transition-transform group-hover:-translate-x-1 md:text-3xl">
          {prev.shortTitle}
        </span>
      </a>
      <a href={`/projects/${next.slug}`} class="group text-right">
        <span class="label">Next →</span>
        <span class="headline mt-2 block text-xl transition-transform group-hover:translate-x-1 md:text-3xl">
          {next.shortTitle}
        </span>
      </a>
    </nav>
  </article>
</Base>
