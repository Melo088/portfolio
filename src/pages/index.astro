---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HalftoneHero from '../react/HalftoneHero';
import BlurReveal from '../react/BlurReveal';
import MagneticLink from '../react/MagneticLink';
import VelocityTicker from '../react/VelocityTicker';
import { site, projects, tickerSkills } from '../data/site';
---

<Base>
  <!-- Hero -->
  <section class="flex min-h-svh flex-col justify-center px-6 pt-20">
    <h1 class="sr-only">{site.name}, Cloud & DevOps Engineering</h1>
    <HalftoneHero
      client:load
      lines={site.wordmark}
      className="mx-auto h-[30svh] w-full max-w-7xl md:h-[54svh]"
    />
    <div class="mx-auto mt-8 w-full max-w-6xl text-center">
      <p class="text-sm font-bold uppercase tracking-[0.3em] md:text-base">
        <BlurReveal client:load text={site.taglines[0]} delay={200} />
      </p>
      <p class="text-muted mt-3 text-xs font-bold uppercase tracking-[0.25em] md:text-sm">
        <BlurReveal client:load text={site.taglines[1]} delay={600} step={40} />
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <MagneticLink client:load href="/#projects" variant="solid">
          View projects
        </MagneticLink>
        <MagneticLink client:load href="/cv">View CV</MagneticLink>
      </div>
    </div>
    <div class="text-muted pb-8 pt-14 text-center text-xs uppercase tracking-widest" aria-hidden="true">
      <span class="inline-block animate-bounce">↓</span> scroll
    </div>
  </section>

  <!-- Skills ticker, reacts to scroll velocity -->
  <section class="border-line overflow-hidden border-y py-8 md:py-10">
    <VelocityTicker client:visible items={tickerSkills} />
  </section>

  <!-- Projects -->
  <section id="projects" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 md:py-28">
    <p class="text-muted text-xs font-bold uppercase tracking-widest">Selected work</p>
    <h2 class="text-condensed mt-4 text-4xl font-black uppercase leading-none md:text-6xl">
      Projects
    </h2>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <!-- Short bio -->
  <section class="border-line border-t">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <p class="text-muted text-xs font-bold uppercase tracking-widest">About me</p>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed md:text-2xl">
        <BlurReveal client:visible text={site.bio} step={12} />
      </p>
      <div class="mt-10">
        <MagneticLink client:visible href="/about">More about me</MagneticLink>
      </div>
    </div>
  </section>
</Base>
