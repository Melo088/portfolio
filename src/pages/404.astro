---
import Base from '../layouts/Base.astro';
import MagneticLink from '../react/MagneticLink';
---

<Base title="404" description="The page you were looking for is not here.">
  <section class="mx-auto flex min-h-svh max-w-6xl flex-col justify-center px-5 py-32 md:px-8">
    <p class="label">(404) Not found</p>
    <h1 class="display ink-lg mt-4 text-[clamp(5rem,22vw,16rem)]">404</h1>
    <p class="text-fg-2 mt-6 max-w-prose text-[17px] leading-relaxed">
      This page inked itself off the plate. The link may be old, or the path misspelled.
    </p>
    <div class="mt-10">
      <MagneticLink client:visible href="/" variant="solid">Back home</MagneticLink>
    </div>
  </section>
</Base>
